# FORGE 2.0 — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Self-hosted Supabase (Docker) — Build Memory backend
FORGE_SUPABASE_URL=http://localhost:54321
FORGE_SUPABASE_ANON_KEY=
FORGE_SUPABASE_SERVICE_KEY=

# Anthropic Claude API (used by Phase 1A/1B and agent generation)
ANTHROPIC_API_KEY=

# Provider Router (src/engine/provider-router.ts) — multi-provider routing for all non-Claude-Code
# reasoning calls (Phase 1A PRD, Phase 1B architecture, Phase 5 agent creation). A missing key just
# drops that provider from routing/failover; it never crashes FORGE.
#   anthropic (primary complex reasoning) reuses ANTHROPIC_API_KEY above.
OPENAI_API_KEY=          # GPT-4o-mini — validation + simple analysis
GEMINI_API_KEY=          # Gemini 1.5 Flash — documentation + research verification (or GOOGLE_API_KEY)
DEEPSEEK_API_KEY=        # DeepSeek Chat — code review + pattern matching

# LiteLLM routing layer (optional). When FORGE_LITELLM_PROXY_URL is set, every provider call is sent
# OpenAI-style to the LiteLLM proxy (run `litellm --config litellm.config.yaml`), which performs the
# vendor dispatch. Unset = the router calls each provider's native endpoint directly via fetch.
FORGE_LITELLM_PROXY_URL=
FORGE_LITELLM_PROXY_KEY=

# Per-machine identity for multi-machine build coordination (auto-generated UUID)
FORGE_MACHINE_ID=

# Filesystem locations
FORGE_DATA_DIR=D:\forge-data
FORGE_BACKUP_DIR=E:\forge-backups

# Structured logging (src/tools/forge-logger.ts). All optional — sane defaults apply.
FORGE_LOG_DIR=                  # log directory (default: <cwd>/logs). Per-build JSON at builds/<build_run_id>.jsonl
FORGE_LOG_LEVEL=                # STDOUT level: trace|debug|info|warn|error|fatal (default: info). Files keep debug+.
FORGE_LOG_ERROR_PATTERNS=       # set to 0 to disable feeding error/fatal logs into Build Memory error_patterns
# NO_COLOR=1                    # (standard) disable colorized pino-pretty output
