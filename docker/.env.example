# FORGE 2.0 — Supabase self-hosting secrets (TEMPLATE).
# =====================================================
# Copy to docker/.env (or let start-forge-db.ps1 generate one). NEVER commit
# docker/.env.
#
# The values below are the PUBLIC Supabase demo keys — safe for a brand-new
# local stack but PUBLICLY KNOWN. start-forge-db.ps1 runs `node gen-secrets.cjs`
# on first launch to replace them with freshly-signed, secure secrets.
# To rotate manually:  node docker/gen-secrets.cjs --force
#
# ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET. They are
# a matched set — regenerating JWT_SECRET invalidates both, so always rotate
# the three together (gen-secrets.cjs does this for you).

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
