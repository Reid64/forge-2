{
  "schema_version": "1.0",
  "project_name": "forge-2",
  "hooks": [
    {
      "name": "sync-pull-start",
      "event": "SessionStart",
      "action": "node dist/cli/index.js learn sync --direction pull",
      "script": null,
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 1,
      "description": "Pull latest learning data from master DB at session start",
      "conditions": null
    },
    {
      "name": "fingerprint-check",
      "event": "SessionStart",
      "action": "powershell",
      "script": "Invoke-FingerprintCheck",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 2,
      "description": "Detect files changed between runs via SHA-256 fingerprint",
      "conditions": null
    },
    {
      "name": "governance-rules-load",
      "event": "SessionStart",
      "action": "powershell",
      "script": "Invoke-GovernanceRulesLoad",
      "blocking": false,
      "timeout_seconds": 15,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 3,
      "description": "Load active governance rules into session context",
      "conditions": null
    },
    {
      "name": "fix-patterns-inject",
      "event": "PreToolUse",
      "action": "powershell",
      "script": "Invoke-FixPatternsInject",
      "blocking": false,
      "timeout_seconds": 10,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 10,
      "description": "Inject known fix patterns into prompt context before execution",
      "conditions": {
        "file_pattern": null,
        "exclude_pattern": null,
        "task_types": ["FIX", "CRUD", "INTEGRATION", "AI_PIPELINE"],
        "min_prompt_number": 2
      }
    },
    {
      "name": "governance-rules-inject",
      "event": "PreToolUse",
      "action": "powershell",
      "script": "Invoke-GovernanceRulesInject",
      "blocking": false,
      "timeout_seconds": 10,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 11,
      "description": "Inject active governance rules into prompt context",
      "conditions": null
    },
    {
      "name": "skill-inject",
      "event": "PreToolUse",
      "action": "powershell",
      "script": "Invoke-SkillInject",
      "blocking": false,
      "timeout_seconds": 10,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 12,
      "description": "Inject matching skills from skill_library into prompt context",
      "conditions": null
    },
    {
      "name": "eslint-autofix",
      "event": "PostToolUse",
      "action": "npx eslint --fix {{file}} 2>/dev/null || true",
      "script": null,
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 10,
      "description": "Auto-fix ESLint issues after every file write",
      "conditions": {
        "file_pattern": "*.ts,*.tsx",
        "exclude_pattern": "*.config.*,*.d.ts",
        "task_types": null,
        "min_prompt_number": 0
      }
    },
    {
      "name": "prompt-score-record",
      "event": "PostToolUse",
      "action": "powershell",
      "script": "Invoke-PromptScoreRecord",
      "blocking": false,
      "timeout_seconds": 15,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 20,
      "description": "Record prompt execution result to prompt_scores table",
      "conditions": null
    },
    {
      "name": "error-fingerprint-register",
      "event": "PostToolUse",
      "action": "powershell",
      "script": "Invoke-ErrorFingerprintRegister",
      "blocking": false,
      "timeout_seconds": 15,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 21,
      "description": "Register any errors with fingerprints to fix_patterns table",
      "conditions": null
    },
    {
      "name": "ring1-tsc",
      "event": "PostToolUse",
      "action": "pnpm tsc --noEmit --pretty false",
      "script": null,
      "blocking": true,
      "timeout_seconds": 60,
      "enabled": true,
      "on_failure": "BLOCK",
      "priority": 30,
      "description": "TypeScript compilation check - Ring 1 gate",
      "conditions": {
        "file_pattern": "*.ts,*.tsx",
        "exclude_pattern": null,
        "task_types": null,
        "min_prompt_number": 0
      }
    },
    {
      "name": "ring1-eslint",
      "event": "PostToolUse",
      "action": "npx eslint . --format json --ext .ts,.tsx 2>/dev/null",
      "script": null,
      "blocking": true,
      "timeout_seconds": 60,
      "enabled": false,
      "on_failure": "WARN",
      "priority": 31,
      "description": "ESLint check - Ring 1 gate (disabled until .eslintrc configured)",
      "conditions": {
        "file_pattern": "*.ts,*.tsx",
        "exclude_pattern": null,
        "task_types": null,
        "min_prompt_number": 0
      }
    },
    {
      "name": "precompact-snapshot",
      "event": "PreCompact",
      "action": "powershell",
      "script": "Invoke-PreCompactSnapshot",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 1,
      "description": "Save context state to compact_snapshots before Claude context compaction",
      "conditions": null
    },
    {
      "name": "gitleaks-precommit",
      "event": "PreCommit",
      "action": "gitleaks detect --source={{project_path}} --no-git --exit-code 1 2>/dev/null || echo SKIP",
      "script": null,
      "blocking": true,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "BLOCK",
      "priority": 1,
      "description": "Scan for leaked secrets before every git commit",
      "conditions": null
    },
    {
      "name": "ring2-vitest",
      "event": "PreCommit",
      "action": "pnpm test 2>/dev/null",
      "script": null,
      "blocking": true,
      "timeout_seconds": 120,
      "enabled": true,
      "on_failure": "BLOCK",
      "priority": 10,
      "description": "Run full test suite - Ring 2 gate (every 10th prompt)",
      "conditions": {
        "file_pattern": null,
        "exclude_pattern": null,
        "task_types": null,
        "min_prompt_number": 10
      }
    },
    {
      "name": "ring3-trivy",
      "event": "PreDeploy",
      "action": "trivy fs --severity CRITICAL,HIGH --format json --quiet . 2>/dev/null || echo SKIP",
      "script": null,
      "blocking": true,
      "timeout_seconds": 120,
      "enabled": true,
      "on_failure": "BLOCK",
      "priority": 1,
      "description": "Security vulnerability scan - Ring 3 pre-deploy gate",
      "conditions": null
    },
    {
      "name": "ring3-lighthouse",
      "event": "PreDeploy",
      "action": "powershell",
      "script": "Invoke-LighthouseAudit",
      "blocking": false,
      "timeout_seconds": 300,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 2,
      "description": "Lighthouse performance/accessibility/SEO audit - Ring 3",
      "conditions": null
    },
    {
      "name": "session-state-serialize",
      "event": "SessionEnd",
      "action": "powershell",
      "script": "Invoke-SessionStateSerialize",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 1,
      "description": "Serialize session state to .forge/session_state.json",
      "conditions": null
    },
    {
      "name": "handoff-generate",
      "event": "SessionEnd",
      "action": "powershell",
      "script": "Invoke-HandoffGenerate",
      "blocking": false,
      "timeout_seconds": 60,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 2,
      "description": "Generate SESSION_HANDOFF.md with run summary and next steps",
      "conditions": null
    },
    {
      "name": "decision-weights-update",
      "event": "SessionEnd",
      "action": "powershell",
      "script": "Invoke-DecisionWeightsUpdate",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 3,
      "description": "Update decision_weights from this run's prompt outcomes",
      "conditions": null
    },
    {
      "name": "evolutions-analyze",
      "event": "SessionEnd",
      "action": "powershell",
      "script": "Invoke-EvolutionsAnalyze",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 4,
      "description": "Auto-elevate high-confidence pending_evolutions to governance_rules",
      "conditions": null
    },
    {
      "name": "sync-push-end",
      "event": "SessionEnd",
      "action": "node dist/cli/index.js learn sync --direction push",
      "script": null,
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 5,
      "description": "Push learning data to master DB at session end",
      "conditions": null
    },
    {
      "name": "adversary-review",
      "event": "PostToolUse",
      "action": "powershell",
      "script": "Invoke-AdversaryReview",
      "blocking": false,
      "timeout_seconds": 60,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 50,
      "description": "Run adversarial review on high-complexity prompts",
      "conditions": {
        "file_pattern": null,
        "exclude_pattern": null,
        "task_types": ["INTEGRATION", "AI_PIPELINE", "CRUD"],
        "min_prompt_number": 5
      }
    },
    {
      "name": "six-laws-check",
      "event": "PostToolUse",
      "action": "powershell",
      "script": "Invoke-SixLawsCheck",
      "blocking": true,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "BLOCK",
      "priority": 35,
      "description": "Verify all 6 FORGE governance laws after schema/auth changes",
      "conditions": {
        "file_pattern": "*.sql,*migration*,*auth*,*middleware*",
        "exclude_pattern": null,
        "task_types": null,
        "min_prompt_number": 0
      }
    },
    {
      "name": "next-queue-write",
      "event": "SessionEnd",
      "action": "powershell",
      "script": "Invoke-NextQueueWrite",
      "blocking": false,
      "timeout_seconds": 30,
      "enabled": true,
      "on_failure": "WARN",
      "priority": 99,
      "description": "Write next run queue to FORGE projects directory",
      "conditions": null
    }
  ]
}
