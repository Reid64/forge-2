{
  "name": "forge-2",
  "version": "2.0.0",
  "description": "FORGE 2.0 — Factory for Orchestrated Replicable Governed Execution. A self-learning autonomous software factory CLI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "forge": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "forge": "node dist/cli/index.js",
    "test": "node --import tsx --test tests/learning-database.test.ts tests/learning-fingerprint.test.ts tests/learning-queries.test.ts tests/learning-sync.test.ts",
    "test:memory": "node --import tsx --test tests/memory.test.ts",
    "web:dev": "next dev",
    "web:build": "next build",
    "web:start": "next start",
    "web:typecheck": "tsc --noEmit -p tsconfig.next.json",
    "provision:operator": "node scripts/create-operator-user.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "axe-core": "^4.10.2",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "crawlee": "^3.12.2",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "next": "^14.2.18",
    "node-cron": "^3.0.3",
    "ora": "^8.1.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}